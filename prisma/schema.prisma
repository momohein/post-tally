generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PostType {
  REGISTERED
  EXPRESS
  PARCEL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  posts        Post[]
  lists        PostingList[]
  bagCloses    BagClose[]
}

/// A bag that was closed (full) at an office on a day. Registered, express and parcel bags are numbered
/// separately; the open bag for a service is one more than its last closed bag.
model BagClose {
  id         String   @id @default(cuid())
  office     String
  day        String
  type       PostType
  number     Int
  closedAt   DateTime @default(now())
  closedById String
  closedBy   User     @relation(fields: [closedById], references: [id])

  @@unique([office, day, type, number])
}

/// One company's Certificate of Posting sheet, photographed and saved as a batch.
model PostingList {
  id          String   @id @default(cuid())
  // Customer (sender) name and address from the top of the sheet.
  sender      String?
  // Post office id from src/lib/offices.ts, e.g. "ringsend".
  office      String
  day         String
  scannedAt   DateTime @default(now())
  scannedById String
  scannedBy   User     @relation(fields: [scannedById], references: [id])
  posts       Post[]

  @@index([office, day])
}

model Post {
  id             String   @id @default(cuid())
  // Unique so the same item scanned twice is never counted twice.
  // Null when an item has no tracking number.
  trackingNumber String?  @unique
  type           PostType
  address        String?
  // Post office id from src/lib/offices.ts, e.g. "ringsend".
  office         String
  // Bag number for this item's service that day (Registered bag 1, 2 ... / Express bag 1, 2 ...).
  bag            Int      @default(1)
  // Calendar day in APP_TIMEZONE (YYYY-MM-DD), used for daily totals.
  day            String
  scannedAt      DateTime @default(now())
  scannedById    String
  scannedBy      User     @relation(fields: [scannedById], references: [id])
  // Set when the item came from a company's posting list.
  listId         String?
  list           PostingList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([office, day])
  @@index([listId])
}
