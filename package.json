{
  "name": "post-tally",
  "version": "1.0.0",
  "private": true,
  "description": "Photograph postal labels to log registered, express and parcel posts with daily counts.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/classify.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "add-user": "node scripts/add-user.mjs",
    "make-admin": "node scripts/make-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "nodemailer": "6.10.1",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/nodemailer": "6.4.24",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}
