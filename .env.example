# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL in Docker) ---
POSTGRES_USER=posttally
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=posttally
# Used when running the app on your laptop (npm run dev) against the Docker database.
# Inside docker compose the app uses the "db" host instead (set in docker-compose.yml).
DATABASE_URL=postgresql://posttally:change-this-password@localhost:5433/posttally

# --- Logins (Auth.js / NextAuth) ---
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
# The address people open the app at. Local: http://localhost:3000  Server: https://your-domain
NEXTAUTH_URL=http://localhost:3000

# --- Label reading (Claude API) ---
# Create a key at https://console.anthropic.com  — keep it secret, never put it in front-end code.
ANTHROPIC_API_KEY=
# Model used to read labels. A fast vision-capable model keeps scans quick.
CLAUDE_MODEL=claude-haiku-5-5

# --- Time zone used to group records into days ---
APP_TIMEZONE=Europe/Dublin
