# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL in Docker) ---
POSTGRES_USER=posttally
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=posttally
# Used when running the app on your laptop (npm run dev) against the Docker database.
# Inside docker compose the app uses the "db" host instead (set in docker-compose.yml).
DATABASE_URL=postgresql://posttally:change-this-password@localhost:5433/posttally

# --- Logins (Auth.js / NextAuth) ---
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
# The address people open the app at. Local: http://localhost:3000  Server: https://your-domain
NEXTAUTH_URL=http://localhost:3000

# --- Label reading (Claude API) ---
# Create a key at https://console.anthropic.com  — keep it secret, never put it in front-end code.
ANTHROPIC_API_KEY=
# Model used to read labels. A fast vision-capable model keeps scans quick.
CLAUDE_MODEL=claude-haiku-5-5
# Model used to read whole posting lists (handwriting on a full page). A stronger model reads it more reliably.
CLAUDE_LIST_MODEL=claude-sonnet-5-5

# --- Daily report email ---
# At about 17:30 Irish time the app emails that day's PDF for both offices to all admin accounts.
# With Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters into SMTP_PASS (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: who the email is from (defaults to SMTP_USER) and extra people to send it to (comma-separated).
MAIL_FROM=
REPORT_EMAIL=
# PDF size attached to the email: label (100 x 150 mm) or a4.
REPORT_PDF_SIZE=label
# Protects the automatic daily job. Generate with:  openssl rand -base64 32
CRON_SECRET=

# --- Time zone used to group records into days ---
APP_TIMEZONE=Europe/Dublin
